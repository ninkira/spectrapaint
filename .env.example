# Optional settings for the Docker route. Copy to `.env` next to compose.yaml to use them —
# `docker compose` reads that file automatically. Every one of these has a working default, so
# an empty or missing .env is fine.

# The address you open in your browser: http://localhost:<this>
# Change it only if something else already uses 8756.
# SPECTRAPAINT_PORT=8756

# Linux only, and only if you switched compose.yaml to bind-mounted host folders. Set these to
# your own ids (`id -u` and `id -g`) so the container may write them, then rebuild:
#     docker compose build && docker compose up
# On Docker Desktop (Windows/macOS) ownership is remapped for you — leave these alone.
# SPECTRAPAINT_UID=1000
# SPECTRAPAINT_GID=1000

# Host folders, used only with the bind-mount lines in compose.yaml uncommented.
# The imaging folder is where cubes end up and can grow to many gigabytes — put it on a disk
# with room. The state folder holds app.db, which is every project, ROI and annotation you have.
# SPECTRAPAINT_DATA_DIR=./docker-data/imaging
# SPECTRAPAINT_STATE_DIR=./docker-data/state
